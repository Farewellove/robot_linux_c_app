-.PHONY: all clean
+# 协议测试只依赖协议的纯函数实现，不链接 socket/线程，便于独立与插桩测试
+PROTO_SRC := $(SRCDIR)/robot_protocol.c
+
+.PHONY: all clean test test-asan mock cross-check help
 
 all: $(TARGET)
 
@@ -33,5 +42,39 @@ $(OBJDIR)/%.o: $(SRCDIR)/%.c
 	@mkdir -p $(OBJDIR)
 	$(CC) $(CFLAGS) -I$(INCDIR) -c -o $@ $<
 
+# 协议解析状态机测试：直接编译生产解析器源码，测的就是上线代码
+$(TESTBIN): $(TESTDIR)/test_protocol.c $(PROTO_SRC)
+	$(CC) $(CFLAGS) -I$(INCDIR) -o $@ $^
+
+# loopback 模拟机器人服务端（仅测试用，不参与主程序链接）
+$(MOCKBIN): $(TESTDIR)/mock_robot.c
+	$(CC) $(CFLAGS) -o $@ $^
+
+test: $(TESTBIN)
+	./$(TESTBIN) performance_evaluation/results/03_parser_tests.csv
+
+# AddressSanitizer + UndefinedBehaviorSanitizer 版本：用于排查越界/未定义行为。
+# 注意：ASan 只能"报出问题"，未报警不等于形式化证明无缺陷。
+test-asan:
+	$(CC) -std=c11 -Wall -Wextra -O1 -g -pthread -D_POSIX_C_SOURCE=200112L \
+	      -fsanitize=address,undefined -fno-omit-frame-pointer \
+	      -I$(INCDIR) -o $(TESTBIN)_asan $(TESTDIR)/test_protocol.c $(PROTO_SRC)
+	ASAN_OPTIONS=detect_leaks=1 ./$(TESTBIN)_asan /tmp/03_parser_tests_asan.csv
+
+mock: $(MOCKBIN)
+
+# 交叉编译可用性检查：只编译不链接运行，产物用于确认 ARM 工具链能通过
+cross-check:
+	@command -v arm-linux-gnueabihf-gcc >/dev/null 2>&1 || \
+		{ echo "arm-linux-gnueabihf-gcc not found"; exit 1; }
+	arm-linux-gnueabihf-gcc $(CFLAGS) -I$(INCDIR) -c -o /tmp/cross_check_main.o $(SRCDIR)/main.c
+	arm-linux-gnueabihf-gcc $(CFLAGS) -I$(INCDIR) -c -o /tmp/cross_check_metrics.o $(SRCDIR)/metrics.c
+	arm-linux-gnueabihf-gcc $(CFLAGS) -I$(INCDIR) -c -o /tmp/cross_check_proto.o $(PROTO_SRC)
+	@echo "cross-check OK (ARM objects built)"
+
+help:
+	@echo "targets: all (default) | mock | test | test-asan | cross-check | clean"
+
 clean:
-	rm -rf $(OBJDIR) $(TARGET)
+	rm -rf $(OBJDIR) $(TARGET) $(TESTBIN) $(TESTBIN)_asan $(MOCKBIN)
+
